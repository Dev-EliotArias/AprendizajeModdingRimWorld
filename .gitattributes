# Normaliza los finales de línea: en el repo se guardan como LF,
# y Git los convierte a CRLF en Windows al hacer checkout.
* text=auto

# Código y XML de RimWorld
*.cs      text diff=csharp
*.xml     text
*.csproj  text
*.slnx    text
*.sln     text eol=crlf
*.md      text
*.json    text

# Binarios: Git no intenta hacer diff ni convertir finales de línea
*.png     binary
*.jpg     binary
*.jpeg    binary
*.dds     binary
*.psd     binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.dll     binary
