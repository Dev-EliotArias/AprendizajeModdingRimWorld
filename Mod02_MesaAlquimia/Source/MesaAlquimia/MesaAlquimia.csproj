<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4850" />
  </ItemGroup>

  <Target Name="CopyToMod" AfterTargets="Build">
    <ItemGroup>
      <ModAssemblies Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAssemblies)" DestinationFolder="$(ProjectDir)..\..\Assemblies\" />
  </Target>

</Project>
